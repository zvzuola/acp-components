{
  "name": "@acp-components/react",
  "version": "0.1.0",
  "description": "React UI components for the Agent Client Protocol — chat, file tree, diff viewer, dialogs, and a composable workbench shell.",
  "keywords": [
    "agent-client-protocol",
    "acp",
    "react",
    "chat-ui",
    "agent",
    "ai",
    "components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zvzuola/acp-components.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/zvzuola/acp-components#readme",
  "bugs": {
    "url": "https://github.com/zvzuola/acp-components/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/react.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@acp-components/core": "workspace:*",
    "@ant-design/icons": "^6.2.5",
    "i18next": "^26.1.0",
    "react-i18next": "^17.0.7",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "monaco-editor": "^0.52.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.99.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
